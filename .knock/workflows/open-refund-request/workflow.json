{
  "name": "Open Refund Request",
  "description": "Catalogue #3: tells every Platform Admin about a new Open Refund Request. Feed only in v1; an email step can be added later.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "categories": [
    "open-refund-requests"
  ],
  "trigger_frequency": "every_trigger",
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
